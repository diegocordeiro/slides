# Copie este arquivo para editor_slides/.env e preencha a(s) chave(s).
# O .env está no .gitignore e o "make checar" bloqueia a publicação se ele entrar no git.
# Só o servidor local (make editor) lê estas chaves; elas nunca vão para o navegador.

# Provedor padrão do editor
DEEPSEEK_API_KEY=

# Opcionais (selecione no editor, aba IA, ou rode: make editor LLM=openai)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
